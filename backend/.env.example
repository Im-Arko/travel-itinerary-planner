# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
# Supabase/PostgreSQL: overrides DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# Use the exact Session pooler URL from Supabase Connect, with a dedicated runtime role.
# DATABASE_URL=postgresql://ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# DB_SCHEMA=travellant
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_app
DB_USER=travel_user
DB_PASSWORD=
# Required in production; CA certificate used to verify the database and hostname.
# DB_SSL_CA=/run/secrets/database-ca.pem
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
# Existing user IDs granted permission to rebuild destination embeddings.
ADMIN_USER_IDS=
USE_MOCK_LLM=false
LLM_PROVIDER=google
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Trust only the immediate reverse proxy; direct clients cannot set their own IP.
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
